rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonction pour vérifier si l'utilisateur est admin
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.admin == true;
    }
    
    // Collection produits
    match /products/{productId} {
      allow read: if true; // Lecture publique
      allow write: if isAdmin(); // Seuls les admins peuvent écrire
    }
    
    // Collection commandes
    match /orders/{orderId} {
      allow read: if isAdmin() || 
                  request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }
    
    // Collection utilisateurs
    match /users/{userId} {
      allow read: if isAdmin() || request.auth != null && request.auth.uid == userId;
      allow write: if isAdmin() || request.auth != null && request.auth.uid == userId;
    }
    
    // Collection collections (catégories)
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Collection stock
    match /stock/{stockId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Collection settings (configuration admin)
    match /settings/{settingId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
